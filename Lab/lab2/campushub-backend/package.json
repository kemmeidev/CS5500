{
  "name": "campushub-backend",
  "version": "1.0.0",
  "description": "Multi-tenant campus resource management system - backend service",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/app.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/app.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:openapi": "redocly lint docs/openapi.yaml",
    "format": "prettier --write ."
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@redocly/cli": "^2.55.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongoose": "^9.10.2"
  }
}
